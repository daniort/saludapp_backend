PORT=3000
PUBLIC_BASE_URL=https://abundant-smile-production-15a63da4.up.railway.app

# Enlaces verificados de la aplicación móvil. Los endpoints .well-known
# responderán sin asociaciones hasta que estos identificadores sean válidos.
ANDROID_PACKAGE_NAME=com.example.saludapp
ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
IOS_TEAM_ID=ABCDEFGHIJ
IOS_BUNDLE_ID=com.example.saludapp

# PLAY_STORE_URL es opcional si ANDROID_PACKAGE_NAME está configurado.
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.saludapp
APP_STORE_URL=https://apps.apple.com/app/id0000000000

FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FIREBASE_AUTH_REQUEST_URI=http://localhost

PGHOST=localhost
PGUSER=postgres
PGPASSWORD=replace-with-your-postgres-password
PGDATABASE=saluback
PGPORT=5432
