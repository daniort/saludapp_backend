  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario con correo y contraseña",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El usuario fue registrado', function () {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('idToken', response.data.tokens.idToken);",
                  "  pm.collectionVariables.set('refreshToken', response.data.tokens.refreshToken);",
                  "  pm.collectionVariables.set('profileId', response.data.profile.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"givenNames\": \"Usuario\",\n  \"paternalSurname\": \"Prueba\",\n  \"maternalSurname\": null,\n  \"birthDate\": \"1990-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Crea una cuenta de Firebase, su usuario local y su perfil personal; guarda los tokens en las variables de la colección."
          },
          "response": []
        },
        {
          "name": "Login con correo y contraseña",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La respuesta tiene un código exitoso', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('idToken', response.data.tokens.idToken);",
                  "  pm.collectionVariables.set('refreshToken', response.data.tokens.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Autentica un usuario con Firebase mediante correo y contraseña. Guarda automáticamente los tokens en variables de la colección."
          },
          "response": []
        },
        {
          "name": "Login con Google",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El usuario inició sesión con Google', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('idToken', response.data.tokens.idToken);",
                  "  pm.collectionVariables.set('refreshToken', response.data.tokens.refreshToken);",
                  "  pm.collectionVariables.set('profileId', response.data.profile.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json", "type": "text"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"googleIdToken\": \"{{googleIdToken}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login", "google"]
            },
            "description": "Intercambia un Google ID token por tokens de Firebase y crea los datos locales si es necesario."
          },
          "response": []
        },
        {
          "name": "Renovar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La sesión fue renovada', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('idToken', response.data.tokens.idToken);",
                  "  pm.collectionVariables.set('refreshToken', response.data.tokens.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json", "type": "text"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          },
          "response": []
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{idToken}}", "type": "text"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Valida la sesión y responde 204. El cliente debe eliminar sus tokens y desactivar la selección automática de Google."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "Obtener usuario actual",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El usuario actual fue consultado', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  const personalProfile = response.data.profiles.find(profile => profile.profileType === 'personal');",
                  "  if (personalProfile) pm.collectionVariables.set('profileId', personalProfile.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{idToken}}", "type": "text"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "me"]
            }
          },
          "response": []
        }
      ]
    },
